# Copy this file to .env and provide real values locally. Do not commit .env.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER=gemini

CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=azure_best_practices
EMBEDDING_MODEL=all-MiniLM-L6-v2
AZURE_SUBSCRIPTION_ID=

OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0
OLLAMA_REQUEST_TIMEOUT=60
OLLAMA_NUM_PREDICT=450
RETRIEVAL_TOP_K=3
ALLOW_TRACE_RESPONSE=false

RAGAS_EVALUATOR_PROVIDER=gemini
RAGAS_EVALUATOR_MODEL=gemini-3.6-flash
RAGAS_API_BASE_URL=http://127.0.0.1:8000
RAGAS_REQUEST_TIMEOUT=60
RAGAS_MAX_RETRIES=2
RAGAS_MAX_WAIT=8
RAGAS_JUDGE_CONCURRENCY=4
RAGAS_CORRECTNESS_TIMEOUT=120
RAGAS_CORRECTNESS_MAX_RETRIES=4
RAGAS_CORRECTNESS_MAX_WAIT=20
GROQ_API_KEY=
